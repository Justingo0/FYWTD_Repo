[gd_scene load_steps=3 format=3 uid="uid://bi7eahu2v8cum"]

[sub_resource type="GDScript" id="GDScript_1hq3u"]
script/source = "extends Area2D

@export var item:PackedScene = null
@export var isWeapon:bool = false

func _on_body_entered(body: Node2D) -> void:
	if body.get_class() == \"CharacterBody2D\":
		body.hovered_item = self

func _on_body_exited(body: Node2D) -> void:
	if body.get_class() == \"CharacterBody2D\":
		if body.hovered_item == self:
			body.hovered_item = null
"

[sub_resource type="CircleShape2D" id="CircleShape2D_i3c12"]
radius = 400.0

[node name="Item" type="Area2D"]
scale = Vector2(0.5, 0.5)
script = SubResource("GDScript_1hq3u")

[node name="BodyCollision" type="CollisionShape2D" parent="."]
shape = SubResource("CircleShape2D_i3c12")

[node name="ColorRect" type="ColorRect" parent="."]
offset_left = -64.0
offset_top = -64.0
offset_right = 64.0
offset_bottom = 64.0
color = Color(0, 1, 0.588235, 1)

[connection signal="body_entered" from="." to="." method="_on_body_entered"]
[connection signal="body_exited" from="." to="." method="_on_body_exited"]
